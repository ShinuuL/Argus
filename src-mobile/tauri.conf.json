{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus Celular",
  "version": "0.1.5",
  "identifier": "dev.argus.celular",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argus",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src http: https:; base-uri 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../src-tauri/icons/32x32.png",
      "../src-tauri/icons/128x128.png",
      "../src-tauri/icons/128x128@2x.png",
      "../src-tauri/icons/icon.icns",
      "../src-tauri/icons/icon.ico"
    ]
  }
}
