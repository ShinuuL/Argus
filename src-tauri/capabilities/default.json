{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões das janelas do Argus (janela principal e janelas auxiliares abertas pela interface). Trazer à frente e redimensionar servem à ponte de validação, que precisa da janela desobstruída e sempre do mesmo tamanho para fotografar.",
  "windows": ["main", "aux-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-outer-size",
    "core:window:allow-outer-position",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
